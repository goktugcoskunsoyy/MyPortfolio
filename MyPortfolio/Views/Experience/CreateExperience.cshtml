@model Experience

@{
    ViewData["Title"] = "CreateExperience";
    Layout = "~/Views/Layout/index.cshtml";
}


<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Deneyimler</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Deneyim Ekleme Sayfası</div>
					</div>
					<div class="card-body">

						<form method="post"> 
                         <label>Firma Bilgisi</label>
							<input type="text" asp-for="Company" class="form-control" />
							<br/>
							<label>Çalışılan Pozisyon</label>
							<input type="text" asp-for="Title" class="form-control" />
							<br />
						<textarea rows="4" asp-for="Description" class="form-control"> </textarea>
							<br />
							<button class="btn btn-primary">Deneyimi Ekle</button>
                        </form>
                

					</div>
				</div>
			</div>
		</div>
	</div>
</div>