@{
    Layout = null;
}
@model List<MyPortfolio.Entities.Experience>



 <section id="experience" class="section" aria-labelledby="exp-title">
      <div class="wrap xp__grid">
        <div class="xp__aside">
          <p class="eyebrow rv">-KARİYER YOLCULUĞUM</p>
          <h2 id="exp-title" class="sec-title rv d1">Deneyimlerim ve Profesyonel Yolculuğum</h2>
        </div>

        <ol class="xp-list">
            @{
                int i = 1;
            }
            @foreach (var item in Model)
{
   <li class="xp-row rv d1">
            <span class="xp-row__idx">@i.ToString("00")</span>
            <div>
              <h3 class="xp-row__title">@item.Title</h3>
              <p class="xp-org">@item.Company</p>
              <p class="xp-row__desc">@item.Description</p>
            </div>
            <span class="date"></span>
          </li>
i++;
}        
        </ol>
      </div>
    </section>