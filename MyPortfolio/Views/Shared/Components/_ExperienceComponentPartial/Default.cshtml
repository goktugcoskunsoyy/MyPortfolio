@{
    Layout = null;
}

 <section id="experience" class="section" aria-labelledby="exp-title">
      <div class="wrap xp__grid">
        <div class="xp__aside">
          <p class="eyebrow rv">-KARİYER YOLCULUĞUM</p>
          <h2 id="exp-title" class="sec-title rv d1">Deneyimlerim ve Profesyonel Yolculuğum</h2>
        </div>

        <ol class="xp-list">
          <li class="xp-row rv d1">
            <span class="xp-row__idx">01</span>
            <div>
              <h3 class="xp-row__title">Yazılım Eğitmeni ve Kurucu</h3>
              <p class="xp-org">M&amp;Y Yazılım Eğitim Akademi</p>
              <p class="xp-row__desc">Yazılım geliştirme alanında uygulamalı eğitim programları, proje tabanlı bootcamp süreçleri ve kariyer odaklı teknoloji eğitimleri.</p>
            </div>
            <span class="date">[Başlangıç] - [Bitiş]</span>
          </li>
          <li class="xp-row rv d2">
            <span class="xp-row__idx">02</span>
            <div>
              <h3 class="xp-row__title">Yazılım Test Mühendisi</h3>
              <p class="xp-org">Yapı Kredi</p>
              <p class="xp-row__desc">Kurumsal bankacılık uygulamalarında yazılım test süreçleri, test otomasyonu, kalite güvence ve çevik geliştirme metodolojileri.</p>
            </div>
            <span class="date">[Başlangıç] - [Bitiş]</span>
          </li>
          <li class="xp-row rv d3">
            <span class="xp-row__idx">03</span>
            <div>
              <h3 class="xp-row__title">Teknoloji İçerik Üreticisi</h3>
              <p class="xp-org">YouTube ve Udemy</p>
              <p class="xp-row__desc">.NET teknolojileri, yazılım geliştirme ve modern uygulama mimarileri üzerine kapsamlı eğitim içeriklerinin hazırlanması.</p>
            </div>
            <span class="date">[Başlangıç] - [Bitiş]</span>
          </li>
        </ol>
      </div>
    </section>