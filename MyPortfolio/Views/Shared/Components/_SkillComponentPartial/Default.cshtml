@{
    Layout = null;
}
@model List<MyPortfolio.Entities.Skill>

 <section id="skills" class="section section--soft" aria-labelledby="skills-title">
    <div class="wrap">

        <div class="sec-head">
            <div>
                <p class="eyebrow rv">-TEKNOLOJİ YIĞINIM</p>
                <h2 id="skills-title" class="sec-title sec-title--narrow rv d1">Kullandığım Teknolojiler ve Uzmanlık Alanlarım</h2>
            </div>
            <p class="sec-lead rv d2">Bir fikrin hayata geçirilmesinden ölçeklenebilir bir yazılım ürününe dönüşmesine kadar farklı teknolojilerle çalışıyorum.</p>
        </div>

        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-xl-4 rv">
                    <article class="skill">
                        <div class="skill__head">
                            <span class="skill__num" aria-hidden="true">@item.SkillOrder.ToString("00")</span>
                            <span class="skill__icon" aria-hidden="true">
                                <img src="@item.IconUrl" alt="" width="24" height="24">
                            </span>
                        </div>
                        <h3 class="skill__title">@item.SkillTitle</h3>
                        <ul class="tags">
                            @foreach (var tag in item.SkillItems)
                            {
                                <li class="tag">@tag.SkillItemTitle</li>
                            }
                        </ul>
                    </article>
                </div>
            }
        </div>
        </div>
</section>
