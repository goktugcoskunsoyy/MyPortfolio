@{
    Layout = null;
}
@model List<MyPortfolio.Entities.About>

 <section id="about" class="about" aria-labelledby="about-title">
      <div class="split">
        <div class="split__media rv">
          <img class="ph-img" src="@ViewBag.AboutImageUrl" alt="Göktuğ Talha Coşkunsoy" loading="lazy">
          <div class="split__badge rbadge" aria-hidden="true">
            <svg class="rbadge__ring" viewBox="0 0 160 160"><defs><path id="rb-about" d="M80,80 m-62,0 a62,62 0 1,1 124,0 a62,62 0 1,1 -124,0"/></defs><text><textPath href="#rb-about" textLength="385" lengthAdjust="spacing">BİLGİSAYAR MÜHENDİSİ • .NET BACKEND • </textPath></text></svg>
            <span class="rbadge__core"><svg class="ico" viewBox="0 0 24 24"><path d="M8 9l-4 3 4 3M16 9l4 3-4 3M13.5 6l-3 12"/></svg></span>
          </div>
        </div>

        <div class="split__body">
          <p class="eyebrow rv">@ViewBag.AboutGreeting</p>
          <h2 id="about-title" class="sec-title rv d1">@ViewBag.AboutTitle</h2>
          <div class="about__copy">
            <p class="about__intro rv d2">@ViewBag.AboutIntro</p>
            <p class="about__text rv d3">@ViewBag.AboutDescription</p>
            <div class="about__cta rv d5">
              <!-- Put your CV PDF at files/ozgecmis.pdf -->
              <a class="cta-link" href="@ViewBag.AboutCvUrl" target="_blank" rel="noopener">Özgeçmişimi İncele <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </div>
        </div>
      </div>
    </section>