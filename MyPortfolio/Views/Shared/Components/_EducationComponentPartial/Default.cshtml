@{
    Layout = null;
} 
@model List<MyPortfolio.Entities.Education>

 <section id="education" class="section section--edu" aria-labelledby="edu-title">
      <div class="wrap edu__grid">
        <div>
          <p class="eyebrow rv">-AKADEMİK YOLCULUK</p>
          <h2 id="edu-title" class="sec-title rv d1">Eğitim Hayatım</h2>
          <figure class="edu-quote rv d2">
            <span class="edu-quote__mark" aria-hidden="true">“</span>
            <blockquote class="edu-quote__text">Öğrenmek bir varış noktası değil, <span class="ul">sürekli devam eden bir yolculuktur.</span></blockquote>
            <figcaption class="edu-quote__note">Yazılım geliştirmek, teknik araştırma yapmak ve öğrendiklerimi paylaşmak benim için birbirini besleyen tek bir döngü. Her yeni proje yeni bir öğrenme fırsatı; her öğrendiğim konu ise paylaşılmayı bekleyen bir içerik.</figcaption>
            <ul class="tags learn-tags" aria-label="Öğrenme alanları"><li class="tag">Sürekli öğrenme</li><li class="tag">Yazılım geliştirme</li><li class="tag">Teknik araştırma</li><li class="tag">Bilgi paylaşımı</li></ul>
          </figure>
        </div>

        <ol class="edu-list">
          
            @foreach (var item in Model)
            {
                <li class="edu-row rv d2">
                    <div class="edu-row__when">
                        <span class="edu-level">@item.Degree</span>
                        <span class="date">@item.Years</span>
                    </div>
                    <div>
                        <h3 class="edu-title">@item.Title</h3>
                        <p class="edu-inst">@item.University</p>
                        <p class="edu-desc">@item.Description</p>
                    </div>
                </li>
            }
        </ol>
      </div>
    </section>